<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>DEEP DIVE | Luxury Abyssal Expeditions & Technical Diving</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&family=Montserrat:wght@200;300;400;500;600&display=swap" rel="stylesheet">
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            abyss: {
              950: '#010409',
              900: '#020813',
              800: '#041226',
              700: '#072247',
            },
            biolum: '#00E5FF',
            jelly: '#E87A48',
          },
          fontFamily: {
            display: ['Montserrat', 'sans-serif'],
            sans: ['Inter', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          }
        }
      }
    }
  </script>

  <style>
    body {
      background-color: #020813;
      color: #FFFFFF;
      font-family: 'Inter', sans-serif;
      overflow-x: hidden;
    }

    /* Ultra-wide style sheet typography */
    .track-hero {
      letter-spacing: 0.42em;
      margin-right: -0.42em;
    }
    .track-sub {
      letter-spacing: 0.35em;
      margin-right: -0.35em;
    }

    /* Anamorphic horizontal cyan light streaks from style sheet */
    .flare-line {
      height: 1px;
      background: linear-gradient(90deg, transparent 0%, rgba(0, 229, 255, 0.25) 20%, rgba(165, 243, 252, 0.95) 50%, rgba(0, 229, 255, 0.25) 80%, transparent 100%);
      box-shadow: 0 0 18px 2px rgba(0, 229, 255, 0.65);
    }

    /* Interactive Flashlight Mask over Hero */
    #flashlight-overlay {
      --x: 50%;
      --y: 50%;
      --radius: 340px;
      background: radial-gradient(
        circle var(--radius) at var(--x) var(--y),
        rgba(1, 4, 9, 0.03) 0%,
        rgba(2, 8, 19, 0.55) 48%,
        rgba(1, 4, 9, 0.97) 100%
      );
      transition: opacity 0.5s ease;
    }

    /* Ambient cursor ring inside hero */
    #flashlight-ring {
      left: var(--x, 50%);
      top: var(--y, 50%);
      transform: translate(-50%, -50%);
      pointer-events: none;
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #010409;
    }
    ::-webkit-scrollbar-thumb {
      background: #072247;
      border-radius: 3px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #00E5FF;
    }

    /* Glassmorphism utility */
    .glass-card {
      background: rgba(4, 18, 38, 0.55);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.12);
    }
    .glass-card:hover {
      border-color: rgba(0, 229, 255, 0.45);
      box-shadow: 0 12px 40px -10px rgba(0, 229, 255, 0.15);
    }
  </style>
</head>
<body class="selection:bg-biolum selection:text-abyss-950">

