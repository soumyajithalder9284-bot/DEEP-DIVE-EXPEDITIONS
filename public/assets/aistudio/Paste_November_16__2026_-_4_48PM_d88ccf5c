          <span>BEAM ACTIVE: MOVE CURSOR</span>
        </div>
        <button id="toggle-floodlight" class="px-3.5 py-1.5 text-[11px] font-mono uppercase tracking-wider border border-white/25 bg-abyss-900/60 hover:border-biolum hover:text-biolum transition">
          Floodlight: OFF
        </button>
      </div>
    </div>

    <!-- Centerpiece: Framed "D E E P / O C E A N" with Jellyfish Depth Accent -->
    <div class="relative z-20 my-auto px-4 flex flex-col items-center text-center">
      <!-- Floating Decorative Jellyfish Accent on Left of Title (Matching Style Sheet) -->
      <div class="relative max-w-4xl w-full flex flex-col items-center">
        <span class="font-mono text-[11px] uppercase tracking-[0.4em] text-biolum/90 mb-5">
          11°21'N 142°12'E • Abyssal Charter Division
        </span>

        <!-- Upper Horizontal Cyan Flare Line -->
        <div class="w-64 sm:w-[460px] flare-line mb-4 sm:mb-6"></div>

        <!-- Main Ultra-Wide Tracked Display Title -->
        <h1 class="font-display font-extralight text-white text-5xl sm:text-7xl md:text-8xl lg:text-[6.5rem] leading-none uppercase track-hero drop-shadow-[0_0_30px_rgba(0,229,255,0.3)]">
          DEEP
        </h1>

        <!-- Lower Horizontal Cyan Flare Line -->
        <div class="w-64 sm:w-[460px] flare-line mt-4 sm:mt-6 mb-5 sm:mb-7"></div>

        <!-- Subtitle Matching Style Sheet -->
        <p class="font-display font-light text-white/90 text-lg sm:text-2xl md:text-3xl uppercase track-sub">
          OCEAN
        </p>

        <p class="mt-6 max-w-lg text-xs sm:text-sm text-white/65 font-light leading-relaxed">
          Bespoke manned submersible descents and closed-circuit technical expeditions into Earth's most remote bioluminescent trenches.
        </p>
      </div>
    </div>

    <!-- Bottom Center CTA: Exact Style Sheet 1px White-Bordered Rectangular Button -->
    <div class="relative z-20 w-full pb-10 sm:pb-14 flex flex-col items-center gap-4">
      <a
        href="#expeditions"
        class="inline-flex items-center justify-center w-44 sm:w-52 py-3.5 border border-white/85 bg-abyss-900/40 backdrop-blur-sm text-white text-xs font-display tracking-[0.28em] uppercase hover:bg-white hover:text-abyss-950 hover:shadow-[0_0_25px_rgba(255,255,255,0.5)] transition duration-300"
