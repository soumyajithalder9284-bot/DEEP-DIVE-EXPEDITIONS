        </div>

        <nav class="mt-10 space-y-5 font-display text-sm tracking-[0.22em] uppercase">
          <a href="#hero" class="drawer-link flex items-center justify-between py-2 text-white/80 hover:text-biolum transition">
            <span>01. Surface / Hero</span>
