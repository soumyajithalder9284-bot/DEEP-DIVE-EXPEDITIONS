      <div class="pt-6 border-t border-white/10 text-xs text-white/50 space-y-2">
        <p class="font-mono text-biolum">SAT-COMM CH: 16 / Iridium 8816-410</p>
        <p>Private Submersible & Closed-Circuit Expeditions</p>
        <p class="text-white/40 pt-1">Developed by Soumyajit Halder</p>
      </div>
    </aside>
  </div>

  <!-- =====================================================================
       1. HERO SECTION (CINEMATIC FIRST IMPRESSION + FLASHLIGHT REVEAL)
  ====================================================================== -->
  <header id="hero" class="relative w-full h-screen min-h-[700px] overflow-hidden select-none bg-abyss-950 flex flex-col justify-between">
    
    <!-- Layer 1: Rich Underwater Background Scene (Revealed by Flashlight) -->
    <div class="absolute inset-0 z-0">
