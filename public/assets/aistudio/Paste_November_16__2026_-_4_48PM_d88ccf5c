    <!-- Layer 3: Foreground Style Sheet UI & Centerpiece -->
    <!-- Top Bar: Style Sheet "Explore" Trigger + Flashlight Controls -->
    <div class="relative z-20 w-full max-w-7xl mx-auto px-6 sm:px-12 pt-8 sm:pt-12 flex items-start justify-between">
      <button id="open-drawer" class="group text-left focus:outline-none" aria-label="Open Explore Menu">
