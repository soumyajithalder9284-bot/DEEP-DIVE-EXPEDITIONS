  <!-- =====================================================================
       JAVASCRIPT: FLASHLIGHT, MARINE SNOW, FILTERS & CALCULATOR
  ====================================================================== -->
  <script>
    // Initialize Lucide icons
    lucide.createIcons();

    // 1. HERO FLASHLIGHT TRACKING + FLOODLIGHT TOGGLE
    const heroSection = document.getElementById('hero');
    const flashlightOverlay = document.getElementById('flashlight-overlay');
    const flashlightRing = document.getElementById('flashlight-ring');
    const floodlightBtn = document.getElementById('toggle-floodlight');
    let floodlightActive = false;

    function updateFlashlightPosition(clientX, clientY) {
      const rect = heroSection.getBoundingClientRect();
      const x = clientX - rect.left;
      const y = clientY - rect.top;
      flashlightOverlay.style.setProperty('--x', `${x}px`);
      flashlightOverlay.style.setProperty('--y', `${y}px`);
      flashlightRing.style.setProperty('--x', `${x}px`);
      flashlightRing.style.setProperty('--y', `${y}px`);
    }

    heroSection.addEventListener('mousemove', (e) => {
      if (!floodlightActive) updateFlashlightPosition(e.clientX, e.clientY);
    });

    heroSection.addEventListener('touchmove', (e) => {
      if (!floodlightActive && e.touches.length > 0) {
        updateFlashlightPosition(e.touches[0].clientX, e.touches[0].clientY);
      }
    }, { passive: true });

    floodlightBtn.addEventListener('click', () => {
      floodlightActive = !floodlightActive;
      flashlightOverlay.style.opacity = floodlightActive ? '0.08' : '1';
      flashlightRing.style.opacity = floodlightActive ? '0' : '1';
      floodlightBtn.textContent = floodlightActive ? 'Floodlight: ON' : 'Floodlight: OFF';
    });

    // 2. FLOATING MARINE SNOW PARTICLES IN HERO
    const canvas = document.getElementById('marine-snow');
    const ctx = canvas.getContext('2d');
    let particles = [];

    function resizeCanvas() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    for (let i = 0; i < 85; i++) {
      particles.push({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        r: Math.random() * 1.8 + 0.4,
        vy: Math.random() * 0.35 + 0.1,
        vx: (Math.random() - 0.5) * 0.25,
        alpha: Math.random() * 0.65 + 0.15
      });
    }

    function animateMarineSnow() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      particles.forEach(p => {
        p.y -= p.vy;
        p.x += p.vx;
        if (p.y < 0) p.y = canvas.height;
        if (p.x < 0) p.x = canvas.width;
        if (p.x > canvas.width) p.x = 0;

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(185, 242, 255, ${p.alpha})`;
        ctx.fill();
      });
      requestAnimationFrame(animateMarineSnow);
    }
    animateMarineSnow();

    // 3. SLIDE-OUT EXPLORE DRAWER
    const drawer = document.getElementById('nav-drawer');
    const panel = document.getElementById('nav-panel');
    const openBtn = document.getElementById('open-drawer');
    const closeBtn = document.getElementById('close-drawer');
    const backdrop = document.getElementById('nav-backdrop');

    function toggleDrawer(show) {
      if (show) {
        drawer.classList.remove('pointer-events-none', 'opacity-0');
        panel.classList.remove('-translate-x-full');
      } else {
        drawer.classList.add('pointer-events-none', 'opacity-0');
        panel.classList.add('-translate-x-full');
      }
    }
    openBtn.addEventListener('click', () => toggleDrawer(true));
    closeBtn.addEventListener('click', () => toggleDrawer(false));
    backdrop.addEventListener('click', () => toggleDrawer(false));
    document.querySelectorAll('.drawer-link').forEach(link => {
      link.addEventListener('click', () => toggleDrawer(false));
    });

    // 4. EXPEDITION DOSSIER & LOGBOOK MODAL DATA
    const expeditionsData = [
      {
        tag: "EXPEDITION DOSSIER // 1,000M SUBMERSIBLE",
        title: "Mariana Bathypelagic Descent",
        body: "Day 1–2: Embarkation in Guam aboard M/Y Abyssal Sovereign and multi-beam sonar mapping. Day 3–6: Four 6-hour dives inside our Triton 3300/3 acrylic sphere down basalt walls, collecting xenophyophore samples with robotic manipulator arms.",
        meta: [["MAX PRESSURE", "101 ATM (Inside: 1 ATM)"], ["SUPPORT VESSEL", "M/Y Abyssal Sovereign"], ["LIFE SUPPORT", "96-Hour O2 Reserve"], ["PILOT CREW", "Ex-Navy Deep Submariner"]]
      },
      {
        tag: "EXPEDITION DOSSIER // 115M CCR DRIFT",
        title: "Raja Ampat Nocturnal Drift",
        body: "Explore the nutrient-rich upwellings of the Dampier Strait after dusk. Using 450nm royal-blue excitation torches and yellow barrier filters, witness deep gorgonian walls, walking epakro sharks, and glowing pelagic jellyfish.",
        meta: [["GAS BLEND", "Trimix 12/60 Diluent"], ["DECO HABITAT", "Submerged 6m O2 Station"], ["WATER VISIBILITY", "35m – 50m"], ["MAX GROUP SIZE", "4 CCR Divers"]]
      },
      {
        tag: "EXPEDITION DOSSIER // 145M TECHNICAL ARCH",
        title: "Dahab Benthic Sinkhole & Arch",
        body: "A precision technical progression culminating in the 145-meter canyon floor below the Red Sea's famous Blue Hole Arch. Full surface-supplied oxygen decompression stations and dedicated safety scooter teams.",
        meta: [["GAS BLEND", "Heliox 10/70"], ["RUN TIME", "210 Minutes Total"], ["CHAMBER PROXIMITY", "On-Site Mobile Unit"], ["GUIDE RATIO", "1:1 Technical Trainer"]]
      }
    ];

    const logbookData = [
      {
        tag: "LOGBOOK TELEMETRY #409 // GPS: 00°32'S 130°28'E",
        title: "Chrysaora Bioluminescence (-180m)",
        body: "Captured during slack tide on a closed-circuit rebreather with zero bubble acoustics. Specimen exhibited rhythmic bioluminescent cascades along its marginal tentacles when stimulated by mesopelagic copepod swarms.",
        meta: [["DEPTH RECORDED", "180.4 Meters"], ["WATER TEMP", "15.2°C"], ["GAS MIX", "Heliox 11/65"], ["BIOLOGIST", "Dr. Aris Thorne"]]
      },
      {
        tag: "LOGBOOK TELEMETRY #412 // GPS: 07°08'N 134°22'E",
        title: "Palau Vertical Halocline (-420m)",
        body: "Observed from the acrylic viewport of Triton 3300/3. A sharp density gradient at 420 meters trapped suspended marine snow, creating an ethereal horizontal cloud layer illuminated by our 15,000-lumen HID array.",
        meta: [["DEPTH RECORDED", "420.0 Meters"], ["WATER TEMP", "8.7°C"], ["MODE", "1 ATM Submersible"], ["VISIBILITY", "52.0 Meters"]]
      },
      {
        tag: "LOGBOOK TELEMETRY #419 // GPS: 11°21'N 142°12'E",
        title: "Mariana Basalt Ridge (-890m)",
        body: "Benthic touchdown along volcanic pillow basalts. Encountered two 4-meter bluntnose sixgill sharks circling our bait lander alongside translucent holothurians.",
        meta: [["DEPTH RECORDED", "890.2 Meters"], ["WATER TEMP", "3.1°C"], ["CHAMBER PRESSURE", "1.0 ATM Constant"], ["BOTTOM TIME", "245 Minutes"]]
      }
    ];

    function showModalContent(item) {
      document.getElementById('modal-tag').textContent = item.tag;
      document.getElementById('modal-title').textContent = item.title;
      document.getElementById('modal-body').textContent = item.body;
      const metaContainer = document.getElementById('modal-meta');
      metaContainer.innerHTML = item.meta.map(([k, v]) => `
        <div>
          <span class="text-white/40 block">${k}</span>
          <span class="text-white">${v}</span>
        </div>
      `).join('');
      const modal = document.getElementById('detail-modal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function openExpeditionModal(idx) {
      showModalContent(expeditionsData[idx]);
    }
    function openLogModal(idx) {
      showModalContent(logbookData[idx]);
    }
    function closeModal() {
      const modal = document.getElementById('detail-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    // 5. CALENDAR FILTER & RESERVE PRE-FILL
    function filterCalendar(cat) {
      document.querySelectorAll('.cal-filter-btn').forEach(btn => {
        const active = btn.dataset.filter === cat;
        btn.className = active
          ? 'cal-filter-btn px-4 py-1.5 text-xs font-mono uppercase border border-biolum bg-biolum/15 text-biolum transition'
          : 'cal-filter-btn px-4 py-1.5 text-xs font-mono uppercase border border-white/15 text-white/70 hover:border-white/40 transition';
      });
      document.querySelectorAll('.cal-row').forEach(row => {
        row.style.display = (cat === 'all' || row.dataset.category === cat) ? 'flex' : 'none';
      });
    }

    function selectExpeditionForInquiry(label) {
      const select = document.getElementById('inquiry-expedition');
      const opt = document.createElement('option');
      opt.value = label;
      opt.textContent = label;
      opt.selected = true;
      select.appendChild(opt);
      document.getElementById('inquiries').scrollIntoView({ behavior: 'smooth' });
    }

    // 6. FLEET TABS
    const fleetInfo = [
      {
        badge: "68-Meter Ice-Class Support Yacht",
        title: "M/Y Abyssal Sovereign",
        desc: "Custom-built in Norway and refitted for ultra-luxury oceanographic exploration. Features dynamic positioning (DP2), an A-frame hydraulic submersible launch hangar, a wet-porch trimix blending lab, and six panoramic owner-grade staterooms.",
        img: "https://images.unsplash.com/photo-1567899378494-47b22a2ae96a?auto=format&fit=crop&w=1400&q=85",
        s1: "6,500 Nautical Miles",
        s2: "12 Guests / 22 Crew",
        s3: "Continuous Heliox / O2",
        s4: "Kongsberg EM 2040"
      },
      {
        badge: "1,000-Meter Acrylic-Hulled Submersible",
        title: "Triton 3300/3 MKII",
        desc: "Featuring the world's thickest distortion-free 360-degree spherical acrylic pressure hull. Guests descend in climate-controlled leather seating at 1 ATM pressure with 7-function Schilling robotic sampling arms and 120,000 lumens of LED cinema lighting.",
        img: "https://images.unsplash.com/photo-1583212292454-1fe6229603b7?auto=format&fit=crop&w=1400&q=85",
        s1: "1,000 Meters (3,300 ft)",
        s2: "1 Pilot + 2 Observers",
        s3: "12 Hours + 96h Reserve",
        s4: "6x 40,000lm Matrix LED"
      }
    ];

    function switchFleetTab(idx) {
      const f = fleetInfo[idx];
      document.getElementById('fleet-badge').textContent = f.badge;
      document.getElementById('fleet-title').textContent = f.title;
      document.getElementById('fleet-desc').textContent = f.desc;
      document.getElementById('fleet-img').src = f.img;
      document.getElementById('fleet-spec-1').textContent = f.s1;
      document.getElementById('fleet-spec-2').textContent = f.s2;
      document.getElementById('fleet-spec-3').textContent = f.s3;
      document.getElementById('fleet-spec-4').textContent = f.s4;

      const t0 = document.getElementById('fleet-tab-0');
      const t1 = document.getElementById('fleet-tab-1');
      if (idx === 0) {
        t0.className = "flex-1 py-5 px-6 font-display text-xs sm:text-sm uppercase tracking-[0.2em] bg-biolum/15 text-biolum border-b-2 border-biolum transition";
        t1.className = "flex-1 py-5 px-6 font-display text-xs sm:text-sm uppercase tracking-[0.2em] text-white/60 hover:text-white transition";
      } else {
        t1.className = "flex-1 py-5 px-6 font-display text-xs sm:text-sm uppercase tracking-[0.2em] bg-biolum/15 text-biolum border-b-2 border-biolum transition";
        t0.className = "flex-1 py-5 px-6 font-display text-xs sm:text-sm uppercase tracking-[0.2em] text-white/60 hover:text-white transition";
      }
    }

    // 7. EQUIPMENT FILTER & RENTAL CALCULATOR
    function filterGear(cat) {
      document.querySelectorAll('.gear-filter-btn').forEach(btn => {
        const active = btn.dataset.gear === cat;
        btn.className = active
          ? 'gear-filter-btn px-4 py-1.5 text-xs font-mono uppercase border border-biolum bg-biolum/15 text-biolum transition'
          : 'gear-filter-btn px-4 py-1.5 text-xs font-mono uppercase border border-white/15 text-white/70 hover:border-white/40 transition';
      });
      document.querySelectorAll('.gear-card').forEach(card => {
        card.style.display = (cat === 'all' || card.dataset.category === cat) ? 'flex' : 'none';
      });
    }

    function updateGearTotal() {
      const days = parseInt(document.getElementById('rental-days').value, 10);
      document.getElementById('days-label').textContent = `${days} DAY${days > 1 ? 'S' : ''}`;
      const listEl = document.getElementById('selected-gear-list');
      let dailySum = 0;
      const itemsHtml = [];

      document.querySelectorAll('.gear-checkbox:checked').forEach(cb => {
        const price = parseInt(cb.dataset.price, 10);
        dailySum += price;
        itemsHtml.push(`
          <div class="flex justify-between text-white/80">
            <span>${cb.dataset.name}</span>
            <span class="text-biolum">$${price * days}</span>
          </div>
        `);
      });

      listEl.innerHTML = itemsHtml.length
        ? itemsHtml.join('')
        : '<span class="text-white/35">Select hardware cards on the left to calculate your custom charter kit.</span>';

      document.getElementById('gear-total-price').textContent = `$${(dailySum * days).toLocaleString()}`;
    }
    updateGearTotal();

    // 8. LOGBOOK DEPTH SCRUBBER
    function filterGalleryByDepth(maxDepth) {
      const d = parseInt(maxDepth, 10);
      document.getElementById('depth-readout').textContent = d === 1000 ? 'ALL (0m – 1,000m)' : `0m – ${d}m MAX`;
      document.querySelectorAll('.log-item').forEach(card => {
        const itemDepth = parseInt(card.dataset.depth, 10);
        card.style.display = itemDepth <= d ? 'block' : 'none';
      });
    }

    // 9. CHARTER FORM SUBMISSION
    function handleCharterSubmit(e) {
      e.preventDefault();
      const feedback = document.getElementById('form-feedback');
      feedback.classList.remove('hidden');
      e.target.reset();
    }
  </script>
