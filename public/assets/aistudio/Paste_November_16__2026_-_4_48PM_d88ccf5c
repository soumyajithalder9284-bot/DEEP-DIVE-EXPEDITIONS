            <span id="stat-vis" class="font-mono text-2xl sm:text-3xl text-white">46.0m</span>
            <span class="text-xs font-mono text-emerald-400">Optimal</span>
          </div>
        </div>
        <div class="glass-card p-5 rounded-sm">
          <span class="font-mono text-[11px] text-white/45 uppercase block mb-1">Surface Swell</span>
          <div class="flex items-baseline justify-between">
            <span id="stat-swell" class="font-mono text-2xl sm:text-3xl text-white">0.4m</span>
            <span class="text-xs font-mono text-white/50">11s Period</span>
          </div>
        </div>
        <div class="glass-card p-5 rounded-sm">
          <span class="font-mono text-[11px] text-white/45 uppercase block mb-1">Benthic Current</span>
          <div class="flex items-baseline justify-between">
            <span id="stat-current" class="font-mono text-2xl sm:text-3xl text-white">0.8 kt</span>
            <span class="text-xs font-mono text-white/50">NNE Drift</span>
          </div>
        </div>
        <div class="glass-card p-5 rounded-sm col-span-2 sm:col-span-1">
          <span class="font-mono text-[11px] text-white/45 uppercase block mb-1">Lunar Biolum Index</span>
          <div class="flex items-baseline justify-between">
            <span class="font-mono text-2xl sm:text-3xl text-jelly">94%</span>
            <span class="text-xs font-mono text-white/60">New Moon</span>
          </div>
        </div>
      </div>

