  <!-- =====================================================================
       3. REAL-TIME CONDITIONS & DIVE CALENDAR
  ====================================================================== -->
  <section id="conditions" class="py-24 sm:py-32 bg-abyss-950/80 border-y border-white/10">
    <div class="max-w-7xl mx-auto px-6 sm:px-12">
      
      <!-- Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
        <div>
          <span class="text-biolum font-mono text-xs uppercase tracking-[0.3em] block mb-3">
            03 // Live Oceanographic Buoy #DD-09
          </span>
          <h2 class="font-display font-light text-3xl sm:text-5xl uppercase tracking-[0.18em]">
            Telemetry & Dive Calendar
          </h2>
        </div>
        <div class="flex items-center gap-3 font-mono text-xs text-white/60">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping"></span>
          <span>BUOY LINK: ONLINE (UPDATED <span id="telemetry-clock">JUST NOW</span>)</span>
        </div>
      </div>

      <!-- Real-Time Ocean Telemetry Bar -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 mb-16">
        <div class="glass-card p-5 rounded-sm">
          <span class="font-mono text-[11px] text-white/45 uppercase block mb-1">Thermocline (40m)</span>
          <div class="flex items-baseline justify-between">
